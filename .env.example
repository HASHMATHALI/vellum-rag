# Environment Variables Template
# Copy this file to .env and configure the fields.

# App Settings
PROJECT_NAME="RAG Semantic Search Platform"
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security and Auth
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD; set it yourself when running outside Docker
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5433/rag_db

# Cache Settings (Redis)
REDIS_URL=redis://redis:6379/0

# Seeded admin account (created on first start; password must be 8+ characters)
ADMIN_EMAIL=admin@vellum.ai
ADMIN_PASSWORD=

# Comma-separated allowed browser origins ("*" = any)
CORS_ORIGINS=*

# Groq API Key for LLM Responses
# Get one from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_goes_here

# Supabase API Settings (For cloud-native deployment)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Ingestion Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=20
