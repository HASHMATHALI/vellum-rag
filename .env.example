# Vellum RAG environment template. Copy to .env and fill in the REQUIRED values.
# Never commit .env. Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

# --- App ---
ENVIRONMENT=production              # production enforces secure settings at startup
PROJECT_NAME="Vellum RAG"

# --- Auth (REQUIRED) ---
JWT_SECRET_KEY=                     # REQUIRED: 64 random hex chars, unique per environment
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true                  # false only for plain-http local testing
COOKIE_SAMESITE=lax                 # use "none" (with COOKIE_SECURE=true) only if the SPA and API are on different sites
ALLOW_GUEST=true                    # isolated, per-visitor guest workspaces purged after GUEST_TTL_HOURS
GUEST_TTL_HOURS=24

# Optional bootstrap admin (created only if both are set; password >= 12 chars and not a known default)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Database (docker-compose) ---
POSTGRES_USER=vellum
POSTGRES_PASSWORD=                  # REQUIRED for docker-compose
POSTGRES_DB=rag_db
# For an external database (Render/Supabase) set DATABASE_URL instead, e.g.
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
ENABLE_RLS=false                    # true after applying backend/app/database/rls.sql and switching to the vellum_app role

# --- Rate limiting cache ---
REDIS_URL=redis://redis:6379/0

# --- CORS / proxy ---
CORS_ORIGINS=http://localhost:8080  # comma-separated exact origins of the frontend
TRUSTED_PROXY_HOPS=1                # number of reverse proxies in front of the backend
HTTP_PORT=8080                      # host port of the nginx gateway

# --- LLM (REQUIRED) ---
GROQ_API_KEY=                       # REQUIRED: https://console.groq.com/
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
PROMPT_GUARD_ENABLED=false          # Llama Prompt Guard 2 scoring of retrieved chunks

# --- Storage: Supabase (optional). Use a PRIVATE bucket and a server-side key. ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_SIZE_MB=20

# --- Retrieval (defaults chosen by evaluation/retrieval_benchmark.py) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RERANKER_ENABLED=true

# --- Observability ---
LOG_JSON=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
TRACE_INCLUDE_CONTENT=false         # never export prompts/document text from production
